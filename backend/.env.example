# ── IBM Granite via NVIDIA's OpenAI-compatible API ──────────────────────────
# Get a free key at https://build.nvidia.com (search "Granite")
# Without a key, the app still fully works using the rules engine + ONNX model.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=ibm/granite-3.3-8b-instruct

# ── Misc ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
